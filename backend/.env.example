APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Postgres (ИСПРАВЛЕНО: заменили @db на @127.0.0.1)
DATABASE_URL=postgresql+asyncpg://pdn:pdn@127.0.0.1:5432/pdn

# Redis / Celery (ИСПРАВЛЕНО: заменили слово redis на 127.0.0.1)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_SECRET=change-me-please-32-chars-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# External services
CRAWLER_URL=http://crowler:8010
PDFREPORT_URL=http://pdfreport:8020

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Сколько страниц парсер обходит за одну проверку (одно значение для всех — подписок нет).
PAID_MAX_PAGES=20

# LLM (OpenAI-compatible). Пусто = AI-анализ отключён, отчёт без ai_analysis.
LLM_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# Почта Resend
RESEND_API_KEY=enterkeyhere