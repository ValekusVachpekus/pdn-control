APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Postgres
DATABASE_URL=postgresql+asyncpg://pdn:pdn@db:5432/pdn

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_SECRET=change-me-please-32-chars-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# External services
CRAWLER_URL=http://crowler:8010
PDFREPORT_URL=http://pdfreport:8020

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Plans / limits
FREE_MAX_PAGES=5
PAID_MAX_PAGES=50

# LLM (OpenAI-compatible). Пусто = AI-анализ отключён, отчёт без ai_analysis.
# DeepSeek V4 Flash (дёшево, $0.14/1M in, $0.28/1M out, 1M context).
# Legacy deepseek-chat будет deprecated 2026-07-24 → используем сразу v4.
#   LLM_API_BASE=https://api.deepseek.com/v1                              LLM_MODEL=deepseek-v4-flash
# Точнее, но дороже:                                                       LLM_MODEL=deepseek-v4-pro
# Qwen / DashScope:
#   LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1        LLM_MODEL=qwen-plus
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
