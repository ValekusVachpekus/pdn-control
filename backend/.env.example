APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Postgres
DATABASE_URL=postgresql+asyncpg://pdn:pdn@db:5432/pdn

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_SECRET=change-me-please-32-chars-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# External services
CRAWLER_URL=http://crowler:8010
PDFREPORT_URL=http://pdfreport:8020

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Сколько страниц парсер обходит за одну проверку (одно значение для всех — подписок нет).
PAID_MAX_PAGES=20

# LLM (OpenAI-compatible). Пусто = AI-анализ отключён, отчёт без ai_analysis.
#
# По умолчанию — Alibaba DashScope (qwen-plus, Singapore-endpoint, поддержка
# response_format=json_object). Ключ — на bailian.console.alibabacloud.com.
#
# Альтернативные модели на DashScope:
#   LLM_MODEL=qwen-turbo    # дёшево
#   LLM_MODEL=qwen-plus     # баланс цены/качества (default)
#   LLM_MODEL=qwen-max      # топ-качество, дороже
#
# Альтернативные провайдеры:
#   DeepSeek V4 Flash:
#     LLM_API_BASE=https://api.deepseek.com/v1     LLM_MODEL=deepseek-v4-flash
LLM_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus
