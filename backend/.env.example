APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Postgres — креды для docker-compose (интерполяция в docker-compose.yml).
# POSTGRES_PASSWORD ОБЯЗАТЕЛЕН (в проде — сильный, не 'pdn'); USER/DB по умолчанию pdn.
# Из этих значений compose собирает DATABASE_URL для api/worker.
POSTGRES_USER=pdn
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=pdn
# Прямой DATABASE_URL нужен только при запуске БЕЗ docker-compose (локально/CI).
DATABASE_URL=postgresql+asyncpg://pdn:pdn@db:5432/pdn

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_SECRET=change-me-please-32-chars-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# External services
CRAWLER_URL=http://crowler:8010
PDFREPORT_URL=http://pdfreport:8020

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Сколько страниц парсер обходит за одну проверку (одно значение для всех — подписок нет).
PAID_MAX_PAGES=20

# LLM (OpenAI-compatible). Пусто = AI-анализ отключён, отчёт без ai_analysis.
#
# По умолчанию — Alibaba DashScope (qwen-plus, Singapore-endpoint, поддержка
# response_format=json_object). Ключ — на bailian.console.alibabacloud.com.
#
# Альтернативные модели на DashScope:
#   LLM_MODEL=qwen-turbo    # дёшево
#   LLM_MODEL=qwen-plus     # баланс цены/качества (default)
#   LLM_MODEL=qwen-max      # топ-качество, дороже
#
# Альтернативные провайдеры:
#   DeepSeek V4 Flash:
#     LLM_API_BASE=https://api.deepseek.com/v1     LLM_MODEL=deepseek-v4-flash
LLM_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# E-mail (passwordless OTP, #55).
# Пусто = DEV-режим: код печатается в лог приложения, письмо НЕ отправляется.
# Реальная отправка — Resend (HTTP API): достаточно задать RESEND_API_KEY
# (секрет кладётся в .env.secret, НЕ сюда) и EMAIL_FROM на верифицированный домен.
RESEND_API_KEY=
EMAIL_FROM=ПДн Контроль <onboarding@resend.dev>
# OTP по умолчанию: код 10 мин, 5 попыток, не чаще 1 кода/60с на e-mail и IP.
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# OAuth соц-вход (Яндекс / ВКонтакте, #72).
# Пусто = провайдер выключен (кнопка входа вернёт ошибку). Секреты кладутся в
# .env.secret, НЕ сюда. ВК — VK ID (OAuth 2.1 + PKCE), секрет не обязателен.
# redirect_uri колбэка = <OAUTH_BACKEND_BASE>/api/auth/oauth/<provider>/callback —
# зарегистрируйте его в кабинете провайдера.
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_BACKEND_BASE=http://localhost:8000
OAUTH_FRONTEND_REDIRECT=http://localhost:5173
OAUTH_STATE_TTL_SEC=600
