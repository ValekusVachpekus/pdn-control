# Пример переменных окружения. Скопируйте в .env и заполните значениями.
# Реальный .env закоммичен НЕ будет (см. .gitignore). Не храните здесь секреты.

# ─────────────────────────────────────────────────────────────
# frontend/ (Vite, переменные с префиксом VITE_ попадают в сборку)
# ─────────────────────────────────────────────────────────────
# Использовать мок-данные вместо реальных запросов к бэкенду (true | false)
VITE_USE_MOCK=true
# Базовый адрес API; пусто = тот же origin через nginx-прокси /api/
VITE_API_BASE=

# ─────────────────────────────────────────────────────────────
# crowler/ (HTTP-микросервис парсера)
# ─────────────────────────────────────────────────────────────
# Сколько проверок выполнять одновременно (каждая поднимает свой браузер)
MAX_CONCURRENT_SCANS=2
# Жёсткий лимит на одну проверку в секундах (при превышении сервис вернёт 504)
SCAN_TIMEOUT_SEC=300
